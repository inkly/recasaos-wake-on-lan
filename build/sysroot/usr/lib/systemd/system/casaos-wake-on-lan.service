[Unit]
After=casaos-gateway.service
After=casaos-user-service.service
Description=Wake-on-LAN module of ReCasaOS

[Service]
ExecStartPre=/usr/bin/casaos-wake-on-lan -v
ExecStart=/usr/bin/casaos-wake-on-lan -c /etc/casaos/wake-on-lan.conf
Type=notify
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
